{
  "$schema": "../product-world.schema.json",
  "id": "teaching-portfolio-home",
  "version": "1.0.0",
  "research": {
    "sources": [
      { "id": "current-demo", "type": "existing-product", "title": "教学档案袋首页现有 Demo" }
    ],
    "actors": [
      { "id": "teacher", "name": "教师" },
      { "id": "portfolio-manager", "name": "教学档案管理员" }
    ],
    "goals": [
      "集中查看个人教学档案概况",
      "快速识别待补充的档案内容",
      "进入各类教学档案业务页面"
    ],
    "painPoints": [
      "档案数据分散，教师难以判断完整度",
      "不同档案入口缺少统一导航"
    ],
    "openQuestions": [
      "完整度计算口径及各类字段权重需要业务确认",
      "不同角色可见的统计卡片范围需要权限调研"
    ]
  },
  "scenario": {
    "name": "教师查看教学档案袋首页",
    "actorRefs": ["teacher"],
    "preconditions": ["教师已登录系统", "教师身份已关联人员主数据"],
    "mainFlow": [
      "系统展示教学档案统计概况",
      "系统展示课程及档案完整度",
      "教师通过菜单进入目标档案页面"
    ],
    "exceptions": ["没有档案数据时使用统一空状态组件", "统计失败时展示可重试的错误状态"]
  },
  "page": {
    "title": "教学档案袋首页",
    "templateId": "dashboard",
    "menuRef": "teaching-portfolio.major:t-home",
    "fieldRefs": [
      "Person.personId",
      "Course.courseId",
      "Course.courseCode",
      "Course.name",
      "Course.totalHours",
      "CoursePortfolio.coursePortfolioId",
      "CoursePortfolio.archiveStatus"
    ],
    "components": ["DSCard", "DSChartCard", "DSDashboardGrid", "DSDataTable", "DSEmptyState"],
    "demoPath": "demos/teaching-portfolio/major/t-home/t-home.html"
  },
  "requirements": {
    "rules": [
      "页面字段必须通过 ontology fieldRef 获取定义",
      "页面菜单必须通过 WiseMenuRegistry 获取地址",
      "页面基础控件必须使用设计系统组件"
    ],
    "acceptanceCriteria": [
      "教师能够查看教学档案概况和完整度",
      "点击菜单能够进入对应档案页面",
      "无数据和加载失败均有明确状态反馈"
    ]
  },
  "artifacts": {
    "requirementDoc": "docs/generated/teaching-portfolio-home.md"
  }
}
