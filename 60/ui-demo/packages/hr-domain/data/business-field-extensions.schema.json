{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://szpu.example/schemas/business-field-extensions-1.0.0.json",
  "type": "object",
  "required": ["library", "version", "registryId", "fields"],
  "properties": {
    "registryId": { "const": "BusinessFieldExtensions" },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fieldId", "fieldKind", "ownerDomain", "label", "classification", "status"],
        "properties": {
          "fieldId": { "type": "string", "pattern": "^Business\\.[a-z][a-z0-9-]*\\.[a-z][a-zA-Z0-9]*$" },
          "fieldKind": { "enum": ["business-extension", "business-specific"] },
          "ownerDomain": { "type": "string", "minLength": 1 },
          "extends": { "type": "string", "pattern": "^StaffBasicInformation\\.[a-z0-9_]+$" },
          "label": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["public", "internal", "sensitive", "restricted"] },
          "status": { "enum": ["draft", "active", "deprecated"] }
        },
        "allOf": [
          {
            "if": { "properties": { "fieldKind": { "const": "business-extension" } } },
            "then": { "required": ["extends"] }
          },
          {
            "if": { "properties": { "fieldKind": { "const": "business-specific" } } },
            "then": { "required": ["dataType", "lifecycle"] }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
